# Только для локальной разработки. В CI .env нет: на GitHub Pages те же значения приходят
# секретами репозитория (Settings → Secrets and variables → Actions):
#   SITE_URL → NEXT_PUBLIC_SITE_URL
#   TG_URL   → NEXT_PUBLIC_TELEGRAM_URL
# Незаданный секрет не ломает сборку — подставляется значение по умолчанию из src/constants/site.ts.

# Базовый адрес сайта: canonical, sitemap.xml, robots.txt и og:url.
# Без слеша на конце. Домен ещё не закреплён — поменять на боевой перед публикацией.
NEXT_PUBLIC_SITE_URL=https://onda-fame.ru

# Куда ведут все кнопки «Связаться с нами».
NEXT_PUBLIC_TELEGRAM_URL=https://t.me/ondafame
