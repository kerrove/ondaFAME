{
  "name": "onda-fame",
  "version": "0.1.0",
  "private": true,
  "author": {
    "name": "Kirill Vegele",
    "email": "kirove.work@gmail.com",
    "url": "https://kerrove.ru"
  },
  "engines": {
    "bun": "^1.2"
  },
  "scripts": {
    "prebuild": "rimraf .next",
    "dev": "next dev -H 0.0.0.0 -p 3000",
    "dev-local": "next dev --turbopack -H 0.0.0.0 -p 3000",
    "build": "node node_modules/next/dist/bin/next build",
    "start": "node node_modules/next/dist/bin/next start",
    "prod": "bun run build && node node_modules/next/dist/bin/next start -H 0.0.0.0 -p 3000",
    "lint": "eslint",
    "test": "jest",
    "test:watch": "jest --watchAll",
    "test:e2e-watch": "bunx playwright test --ui --ui-port=8080 --ui-host=0.0.0.0",
    "test:e2e": "bunx playwright test",
    "check": "knip --config ./knip.json",
    "format": "prettier --write \"src/**/*.{ts,tsx}\""
  },
  "dependencies": {
    "chart.js": "^4.5.1",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.23",
    "framer-motion": "^13.2.0",
    "lucide-react": "^1.41.0",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.87.0",
    "react-hot-toast": "^2.6.0",
    "rimraf": "^6.1.3",
    "tailwind-merge": "^3.6.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/bun": "^1.4.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "depcheck": "^1.4.7",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "^16.3.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "knip": "^6.34.0",
    "prettier": "^3.9.6",
    "sass": "^1.104.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "packageManager": "bun@1.3.8",
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}
